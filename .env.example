# Generation mode per type:
#   mock         - every model of that type returns a bundled sample after 3-8 s (no keys, free)
#   pollinations - images go to each model's real provider: Soul 2 and FLUX to Pollinations,
#                  Nano Banana to Gemini when GEMINI_API_KEY is set.
#   live         - same, for either type. For video: motion previews use the motion provider
#                  (free, no key) and Seedance 1.5 Pro uses fal.ai when FAL_KEY is set.
GENERATION_PROVIDER_IMAGE=pollinations
GENERATION_PROVIDER_VIDEO=live

# Optional keys. Server-side only, never exposed to the browser.
# POLLINATIONS_KEY is sent as a Bearer token; free keys at enter.pollinations.ai.
# Without one, Pollinations allows only a few new images per IP before answering 402.
POLLINATIONS_KEY=
# Enables the Nano Banana model (gemini-2.5-flash-image). Free key at aistudio.google.com.
GEMINI_API_KEY=
# Enables Seedance 1.5 Pro image-to-video (480p, 5 credits) through fal's queue API.
FAL_KEY=

# Testing only: point Pollinations somewhere that refuses connections, e.g.
# http://127.0.0.1:9/, to force a failure and watch the full refund. (An invalid
# model name does not fail; Pollinations falls back to its default model.)
POLLINATIONS_BASE_URL=
